# Copy to .env and fill in. Never commit or share .env.
# See SETUP.md for where each value comes from.

# --- YouTube (Google Cloud, OAuth client type "Desktop app") ---
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json

# --- Facebook Page + Instagram (one Meta app) ---
META_APP_ID=
META_APP_SECRET=
# Short-lived token from Graph API Explorer; the tool exchanges it for a Page token that doesn't expire
META_USER_TOKEN=
# Optional, auto-detected from the token
META_PAGE_ID=
META_IG_USER_ID=

# --- LinkedIn (personal profile) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/linkedin/callback

# --- TikTok (inbox/drafts upload) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8765/tiktok/callback/
