# Copy to .env and fill in. Never commit or share .env.
# See SETUP.md for where each value comes from.

# --- YouTube (Google Cloud project "socialite", OAuth client type "Desktop app") ---
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json

# --- Instagram (Meta app "social-autopost", Instagram API with Instagram Login; posts to @abdulwithai) ---
# Facebook devlobb is a personal profile, so the API can't post there.
# Reels reach Facebook via Instagram's "share to Facebook" setting in Accounts Center.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Long-lived 60-day token from "Generate token" in the Meta dashboard; the tool refreshes it
INSTAGRAM_USER_TOKEN=
# Optional override, default v25.0
INSTAGRAM_API_VERSION=

# --- Meta app keys (OPTIONAL: not used by the tool today; only needed later to post to a Facebook Page) ---
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=

# --- LinkedIn (personal profile; "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect") ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/linkedin/callback
# Optional override of the LinkedIn-Version header, format YYYYMM
LINKEDIN_API_VERSION=
# Access tokens last 60 days; then run `python -m autopost login linkedin` again.

# --- TikTok (sandbox "personal"; uploads go to your TikTok drafts/inbox) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8765/tiktok/callback/

# --- Tool settings ---
# Local port for login redirects; must match the redirect URIs above
AUTOPOST_PORT=8765
# How Instagram gets a temporary public link to your video: auto (cloudflared, then localhost.run), cloudflared, or localhost.run
AUTOPOST_TUNNEL=auto
