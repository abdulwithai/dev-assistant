# Copy to .env and fill in. Never commit or share .env.
# See SETUP.md for where each value comes from.

# --- YouTube (Google Cloud, OAuth client type "Desktop app") ---
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json

# --- Instagram (Meta app "social-autopost", Instagram API with Instagram Login) ---
# Facebook: devlobb is a personal profile, which the API can't post to.
# Reels reach it through Instagram's "share to Facebook" setting (Accounts Center).
# From: Use cases > Instagram API > API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Long-lived token (60 days) generated by "Add account" for @abdulwithai; the tool refreshes it
INSTAGRAM_USER_TOKEN=

# --- LinkedIn (personal profile) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/linkedin/callback

# --- TikTok (inbox/drafts upload) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8765/tiktok/callback/
